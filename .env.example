# Copy this file to .env and fill in your values

# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=
# Client ID of your bot application (for OAuth2 invite link generation)
CLIENT_ID=1368094468489609238

# Dashboard server port
PORT=3000

# Dashboard access token (required when logging in on the web dashboard)
DASHBOARD_TOKEN=change_me_to_a_strong_password

# Optional: webhook URL to forward security alerts to a Discord channel
ALERT_WEBHOOK_URL=
